# Copy to .env for local development. Never commit real production secrets.
DB_PASSWORD=change-this-local-password
DB_URL=jdbc:mysql://localhost:3306/dbpurchase
DB_USERNAME=root
# Generate a unique random secret of at least 32 bytes, e.g. openssl rand -base64 48
IMS_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
IMS_JWT_EXPIRATION_MS=3600000
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VENDOR_SERVICE_URL=http://localhost:8087/vendor
MATERIAL_SERVICE_URL=http://localhost:8088
